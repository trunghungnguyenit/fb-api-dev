# Copy to .env and fill in. Every value below is a PLACEHOLDER; the app refuses to start with these.

# Next.js. Must be the exact origin users open (no trailing slash).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Key that encrypts the stored Facebook tokens. openssl rand -hex 32  (exactly 64 hex characters)
APP_ENCRYPTION_KEY=generate-with-openssl-rand-hex-32
# Key rotation (optional). To switch to a new key WITHOUT losing the stored tokens: keep APP_ENCRYPTION_KEY as it is
# (it is "key 1"), add the new key here and make it the current one. Then restart and run `npm run reencrypt`
# until `npm run reencrypt -- --report` shows no rows on key 1; only then may the old key be removed.
# APP_ENCRYPTION_KEYS={"2":"<another 64 hex characters>"}
# APP_ENCRYPTION_KEY_ID=2

# Supabase project
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Must be the service_role / secret key, NOT the anon key. Server-only.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Meta app
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_GRAPH_API_VERSION=v26.0
# Same origin as NEXT_PUBLIC_APP_URL, path must be /api/auth/facebook/callback
META_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/facebook/callback

# Protects /api/cron/*. openssl rand -hex 32. Placeholders starting with "replace-" are rejected.
CRON_SECRET=replace-with-openssl-rand-hex-32

# Production on a long-running server only: run the background jobs (publish, read Pages' posts, check tokens, clean up
# media) inside the app. Leave unset on serverless and call /api/cron/publish, /api/cron/sync-posts,
# /api/cron/check-pages and /api/cron/cleanup-media from an external scheduler. (`next dev` always runs them.)
# INTERNAL_SCHEDULER=true

# How often each Fanpage's posts are read from Facebook, in minutes (1-60, default 5). Changes made directly on Facebook
# (new posts, deleted posts) reach the app within about this time; opening the posts list or pressing "Tải lại từ
# Facebook" reads at once. Shorter = fresher, but more Graph API calls per Fanpage.
# FEED_SYNC_INTERVAL_MIN=5

# Publisher: how many posts are published at the same time (never two for the same Fanpage). "Heavy" is for posts
# with several images. Defaults shown.
# PUBLISH_CONCURRENCY=8
# PUBLISH_HEAVY_CONCURRENCY=2

# Images. All optional (defaults shown, sizes in MB). These are the ONLY place the limits are written; after changing
# them run `npm run media:sync-bucket` so the Storage bucket's own limit follows. MEDIA_MAX_FILE_MB is the ceiling for any
# single file and also the bucket's limit; it cannot exceed your Supabase plan's global upload limit (50 MB on Free).
# MEDIA_MAX_FILE_MB=50
# MEDIA_MAX_IMAGE_MB=10
# MEDIA_MAX_VIDEO_MB=50
# MEDIA_MAX_REEL_MB=50
# MEDIA_MAX_IMAGES_TOTAL_MB=50
# MEDIA_MAX_IMAGES_PER_POST=10
# MEDIA_RESUMABLE_THRESHOLD_MB=50
# "Import bài viết" with files: how many different files one import may upload (1-60) and their total size.
# MEDIA_IMPORT_MAX_FILES=50
# MEDIA_IMPORT_MAX_TOTAL_MB=500

# How video / Reels reach Facebook: "hosted" (default) = Facebook downloads them from a temporary link; "binary" = this
# server uploads the bytes itself. Switch to binary if Facebook reports it cannot fetch the file.
# META_VIDEO_UPLOAD_MODE=hosted
